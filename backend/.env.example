# Copy to .env and fill in real values. Never commit the real .env file.

ENV=development
SERVERLESS=false
# Required only for Vercel's protected /api/cron/alerts route.
CRON_SECRET=
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-string
SESSION_COOKIE_NAME=vatsim_atc_session
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://vatsim:vatsim@localhost:5432/vatsim_atc_watch

# Register an app at https://auth.vatsim.net to get these
VATSIM_CLIENT_ID=
VATSIM_CLIENT_SECRET=
VATSIM_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
VATSIM_OAUTH_SCOPES=full_name vatsim_details email
OAUTH_STATE_TTL_SECONDS=600

VATSIM_POLL_INTERVAL_SECONDS=15
VATSIM_DATA_STALE_AFTER_SECONDS=60

# Generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

DEFAULT_NOTIFY_MINUTES_BEFORE=15
DEFAULT_NOTIFY_NM_BEFORE=100
DEFAULT_TRAFFIC_RADIUS_NM=150
DEFAULT_ALTITUDE_FILTER_FT=10000
