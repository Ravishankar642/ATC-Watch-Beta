# Copy to .env for local dev, or .env.production for deployment.
# In local dev, Vite proxies /api to the backend (see vite.config.ts), so
# VITE_API_BASE_URL can stay empty. In production, point it at your deployed
# backend's origin (must be HTTPS).

VITE_API_BASE_URL=

# Same VAPID public key printed by backend/scripts/generate_vapid_keys.py.
# Not strictly required at build time (the app fetches it from the backend),
# but useful to keep here for reference/debugging.
VITE_VAPID_PUBLIC_KEY=
