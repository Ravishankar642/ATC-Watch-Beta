# Example Caddyfile for serving ATC Watch Beta over real HTTPS on Ubuntu.
#
# Install:  sudo apt install -y caddy   (or see https://caddyserver.com/docs/install)
# Usage:    replace YOUR-DOMAIN with a real domain that points at this
#           server's public IP, then:
#             sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile
#             sudo systemctl reload caddy
#
# Caddy automatically obtains and renews a Let's Encrypt certificate for
# YOUR-DOMAIN the first time it starts — no manual certbot step needed.
# This is what makes iOS accept the page as HTTPS-trusted, which is required
# for Notification.requestPermission()/PushManager.subscribe() to work at all.

YOUR-DOMAIN {
    # Frontend: static build output from `npm run build` (frontend/dist)
    root * /var/www/atc-watch-beta/frontend-dist
    file_server
    try_files {path} /index.html

    # Backend API: proxy to uvicorn running on localhost:8000
    handle /api/* {
        reverse_proxy localhost:8000
    }
}
